{
 "doctype": "DocType",
 "name": "Ligacao Faturacao",
 "module": "Orbit",
 "custom": 0,
 "engine": "InnoDB",
 "autoname": "field:company",
 "naming_rule": "By fieldname",
 "track_changes": 1,
 "description": "Ligação da empresa a um programa de faturação certificado pela AT (DP8). O Orbit nunca emite documentos fiscais: prepara a venda e pede a emissão ao programa. Uma ligação nova nasce em Ensaio — só cria rascunhos, que se apagam.",
 "fields": [
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Empresa",
   "options": "Company",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "programa",
   "fieldtype": "Select",
   "label": "Programa certificado",
   "options": "moloni",
   "reqd": 1,
   "default": "moloni",
   "in_list_view": 1,
   "description": "InvoiceXpress, TOConline e Vendus entram nas fases C2–C4."
  },
  {
   "fieldname": "activa",
   "fieldtype": "Check",
   "label": "Activa",
   "default": "0",
   "in_list_view": 1,
   "description": "Sem ligação activa, as faturas desta empresa ficam como estavam (nada é enviado)."
  },
  {
   "fieldname": "modo",
   "fieldtype": "Select",
   "label": "Modo",
   "options": "Ensaio\nReal",
   "default": "Ensaio",
   "reqd": 1,
   "in_list_view": 1,
   "description": "Ensaio: só rascunhos, apagados a seguir. Real: documentos fiscais definitivos — só depois de um ensaio bem-sucedido."
  },
  {
   "fieldname": "sec_cred",
   "fieldtype": "Section Break",
   "label": "Credenciais"
  },
  {
   "fieldname": "client_id",
   "fieldtype": "Data",
   "label": "ID da app de programador"
  },
  {
   "fieldname": "client_secret",
   "fieldtype": "Password",
   "label": "Segredo da app de programador"
  },
  {
   "fieldname": "utilizador",
   "fieldtype": "Data",
   "label": "Utilizador de integração",
   "description": "Um utilizador próprio para o Orbit no programa (não a conta pessoal de ninguém)."
  },
  {
   "fieldname": "palavra_passe",
   "fieldtype": "Password",
   "label": "Palavra-passe do utilizador de integração"
  },
  {
   "fieldname": "col_cred",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "empresa_id",
   "fieldtype": "Data",
   "label": "ID da empresa no programa"
